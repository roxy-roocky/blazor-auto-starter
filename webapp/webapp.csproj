<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-webapp-aa727874-4728-43d7-afeb-daab6e1a2ca6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Watch Include="**\*.js" Exclude="node_modules\**\*;**\*.js.map;obj\**\*;bin\**\*" />
    <Watch Include="**\*.css" Exclude="node_modules\**\*;**\*.css.map;obj\**\*;bin\**\*" />
  </ItemGroup>

  <Target Name="Bootstrap" BeforeTargets="BeforeCompile">
    <Exec Command="npx sass -q Styles/:wwwroot/" />
    <Copy SourceFiles="node_modules/bootstrap/dist/js/bootstrap.bundle.min.js" DestinationFolder="wwwroot/bootstrap/" />
    <Copy SourceFiles="node_modules/bootstrap/dist/js/bootstrap.bundle.min.js.map" DestinationFolder="wwwroot/bootstrap/" />
  </Target>


  <ItemGroup>
    <Folder Include="Dependancies/" />
    <Folder Include="Dependancies/Localisation/" />
  </ItemGroup>

  <ItemGroup>
    <_FaWebfonts Include="node_modules/@fortawesome/fontawesome-free/webfonts/*.*" />
  </ItemGroup>

  <Target Name="Fontawesome" BeforeTargets="BeforeCompile">
    <Exec Command="npx sass -q node_modules/@fortawesome/fontawesome-free/scss/:wwwroot/fontawesome/css/" />
    <Copy SourceFiles="@(_FaWebfonts)" DestinationFolder="wwwroot/fontawesome/webfonts/" />
  </Target>


  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.*" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <ProjectReference Include="../html-generator/html-generator.csproj" />
    <ProjectReference Include="../jobcode/jobcode.csproj" />
    <ProjectReference Include="../localization/localization.csproj" />
    <ProjectReference Include="../main-datacontext/main-datacontext.csproj" />
    <ProjectReference Include="..\webapp.Client\webapp.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" />
  </ItemGroup>

</Project>
