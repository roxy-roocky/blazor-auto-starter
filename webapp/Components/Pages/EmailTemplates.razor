@page "/email-templates"
@using Microsoft.AspNetCore.Authorization
@using html_generator.Emails.Templates
@using html_generator.Emails.Shared
@attribute [Authorize]
@attribute [StreamRendering]

<PageTitle>Email Templates</PageTitle>

<div class="container py-4">
    <h1 class="mb-4 text-black">Email Templates Preview</h1>
    <p class="mb-4">Prévisualisation de tous les templates d'emails disponibles</p>

    <div class="accordion" id="emailTemplatesAccordion">

        <!-- Email Template Example -->
        <div class="accordion-item bg-body">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#emailTemplate1" aria-expanded="true" aria-controls="emailTemplate1">
                    <strong>EmailTemplate.razor</strong> <span class="text-muted ms-2">- Template de base avec header et footer</span>
                </button>
            </h2>
            <div id="emailTemplate1" class="accordion-collapse collapse show" data-bs-parent="#emailTemplatesAccordion">
                <div class="accordion-body">
                    <div class="border rounded p-2 bg-body-secondary">
                        <SimpleActionEmailTemplate Subject="Bienvenue sur notre plateforme"
                                       Greeting="Bonjour Jean Dupont,"
                                       CallToActionUrl="https://example.com/get-started"
                                       CallToActionText="Commencer"
                                       FooterText="Vous recevez cet email car vous vous êtes inscrit sur notre plateforme.">
                            <ChildContent>
                                <TextBlock Text="Nous sommes ravis de vous accueillir dans notre communauté. Ce template démontre l'utilisation des composants EmailLayout, TextBlock et ButtonBlock pour créer des emails professionnels sans manipuler directement les tables HTML."
                                           FontSize="15px"
                                           MarginBottom="20px" />

                                <TextBlock Heading="Pourquoi nous choisir ?"
                                           HeadingSize="20px"
                                           Text="Notre plateforme offre des fonctionnalités uniques pour faciliter votre travail quotidien."
                                           MarginBottom="20px" />
                            </ChildContent>
                        </SimpleActionEmailTemplate>
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Example with Components -->
        <div class="accordion-item bg-body">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#emailTemplate3" aria-expanded="false" aria-controls="emailTemplate3">
                    <strong>Exemple personnalisé</strong> <span class="text-muted ms-2">- Démonstration des composants TextBlock et ButtonBlock</span>
                </button>
            </h2>
            <div id="emailTemplate3" class="accordion-collapse collapse" data-bs-parent="#emailTemplatesAccordion">
                <div class="accordion-body">
                    <div class="border rounded p-2 bg-body-secondary">
                        <EmailLayout Title="Notification importante"
                                     BackgroundColor="#e9ecef"
                                     HeaderBackgroundColor="#dc3545"
                                     ShowHeader="true"
                                     ShowFooter="true">
                            <HeaderContent>
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td style="font-family: Arial, sans-serif; font-size: 28px; color: #ffffff; font-weight: bold; text-align: center;">
                                            ⚠️ Action requise
                                        </td>
                                    </tr>
                                </table>
                            </HeaderContent>

                            <ChildContent>
                                <TextBlock Heading="Votre attention est requise"
                                           HeadingSize="24px"
                                           HeadingColor="#dc3545"
                                           Text="Nous avons détecté une activité inhabituelle sur votre compte. Veuillez vérifier les informations ci-dessous."
                                           MarginBottom="25px" />

                                <TextBlock Text="Date de détection : 14 novembre 2025&#10;Heure : 14:30 UTC&#10;Type d'activité : Connexion depuis un nouvel appareil"
                                           FontSize="14px"
                                           TextColor="#555555"
                                           MarginBottom="30px" />

                                <ButtonBlock Href="https://example.com/verify"
                                             Text="Vérifier mon compte"
                                             BackgroundColor="#dc3545"
                                             TextColor="#ffffff"
                                             Align="center"
                                             BorderRadius="6px"
                                             MarginBottom="20px" />

                                <TextBlock Text="Si vous n'êtes pas à l'origine de cette activité, veuillez changer votre mot de passe immédiatement."
                                           FontSize="13px"
                                           TextColor="#999999"
                                           Align="center"
                                           MarginBottom="10px" />

                                <ButtonBlock Href="https://example.com/reset-password"
                                             Text="Changer le mot de passe"
                                             BackgroundColor="#ffffff"
                                             TextColor="#dc3545"
                                             BorderWidth="2px"
                                             BorderColor="#dc3545"
                                             Align="center"
                                             BorderRadius="6px"
                                             MinWidth="220px"
                                             MarginBottom="10px" />
                            </ChildContent>

                            <FooterContent>
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td style="font-family: Arial, sans-serif; font-size: 12px; color: #ffffff; text-align: center; line-height: 1.5;">
                                            Cet email a été envoyé automatiquement. Merci de ne pas y répondre.<br/>
                                            &copy; @DateTime.Now.Year Votre Entreprise - Tous droits réservés
                                        </td>
                                    </tr>
                                </table>
                            </FooterContent>
                        </EmailLayout>
                    </div>
                </div>
            </div>
        </div>

        <!-- Simple Text Example -->
        <div class="accordion-item bg-body">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#emailTemplate4" aria-expanded="false" aria-controls="emailTemplate4">
                    <strong>Email simple</strong> <span class="text-muted ms-2">- Email minimaliste avec composants de base</span>
                </button>
            </h2>
            <div id="emailTemplate4" class="accordion-collapse collapse" data-bs-parent="#emailTemplatesAccordion">
                <div class="accordion-body">
                    <div class="border rounded p-2 bg-body-secondary">
                        <EmailLayout Title="Confirmation d'inscription"
                                     BackgroundColor="#ffffff"
                                     ContentPadding="40px"
                                     ShowHeader="false"
                                     ShowFooter="true"
                                     FooterBackgroundColor="#f8f9fa"
                                     FooterTextColor="#6c757d">
                            <ChildContent>
                                <TextBlock Heading="Merci de votre inscription !"
                                           HeadingSize="26px"
                                           HeadingColor="#28a745"
                                           Text=""
                                           Align="center"
                                           MarginBottom="30px" />

                                <TextBlock Text="Votre compte a été créé avec succès. Vous pouvez maintenant profiter de tous nos services."
                                           FontSize="16px"
                                           TextColor="#555555"
                                           Align="center"
                                           MarginBottom="35px" />

                                <ButtonBlock Href="https://example.com/dashboard"
                                             Text="Accéder à mon tableau de bord"
                                             BackgroundColor="#28a745"
                                             TextColor="#ffffff"
                                             Align="center"
                                             BorderRadius="25px"
                                             MinWidth="280px"
                                             ButtonPadding="15px 35px"
                                             FontSize="16px"
                                             MarginBottom="10px" />
                            </ChildContent>

                            <FooterContent>
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td style="font-family: Arial, sans-serif; font-size: 11px; color: #6c757d; text-align: center;">
                                            Questions ? Contactez-nous à support@example.com
                                        </td>
                                    </tr>
                                </table>
                            </FooterContent>
                        </EmailLayout>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info mt-4">
        <h5>ℹ️ Information</h5>
        <p class="mb-0">
            Ces templates utilisent des tables HTML pour assurer une compatibilité maximale avec tous les clients email
            (Outlook, Gmail, Apple Mail, etc.). Les composants <code>EmailLayout</code>, <code>TextBlock</code> et
            <code>ButtonBlock</code> permettent de créer des emails sans manipuler directement les tables.
        </p>
    </div>
</div>
