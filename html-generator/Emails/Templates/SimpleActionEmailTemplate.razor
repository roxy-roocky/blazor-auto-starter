@using html_generator.Emails.Shared
@using utilities
@using Microsoft.Extensions.Localization
@* Example email template using the new highly compatible components *@
@* This demonstrates how to use EmailLayout, TextBlock, and ButtonBlock *@

@inject IStringLocalizer<SimpleActionEmailTemplate> L

<EmailLayout Title="@Subject"
             ShowHeader="true"
             ShowFooter="true">

    <HeaderContent>
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
                <td style="font-family: Arial, sans-serif; font-size: 28px; color: #ffffff; font-weight: bold; text-align: center;">
                    @Subject
                </td>
            </tr>
        </table>
    </HeaderContent>

    <ChildContent>
        @if (!string.IsNullOrEmpty(Greeting))
        {
            <TextBlock Heading="@Greeting.ToCapitalized()"
                       HeadingSize="24px"
                       Text=""
                       MarginBottom="10px" />
        }

        @* Main content can use TextBlock and ButtonBlock components *@
        @ChildContent

        @if (!string.IsNullOrEmpty(CallToActionUrl))
        {
            <ButtonBlock Href="@(((MarkupString)CallToActionUrl).ToString())"
                         Text="@CallToActionText"
                         Align="center"
                         BorderRadius="5px"
                         MinWidth="200px"
                         BackgroundColor="#975b45"
                         BorderColor="#975b45"
                         MarginBottom="10px" />
        }
    </ChildContent>

    <FooterContent>
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
                <td style="font-family: Arial, sans-serif; font-size: 12px; color: #ffffff; text-align: center; line-height: 1.4;">
                    @if (!string.IsNullOrEmpty(FooterText))
                    {
                        @((MarkupString)FooterText.Replace("\\n", "<br/>").Replace("\n", "<br/>").Replace("\r", ""))
                    }
                    else
                    {
                        @((MarkupString)L["Blazor Auto Starter - © {0} - All rights reserved", DateTime.Now.Year].ToString())
                    }
                </td>
            </tr>
        </table>
    </FooterContent>

</EmailLayout>

@code {
    [Parameter]
    public string Subject { get; set; } = "Email Subject";

    [Parameter]
    public string? Greeting { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? CallToActionUrl { get; set; }

    [Parameter]
    public string CallToActionText { get; set; } = "Click Here";

    [Parameter]
    public string? FooterText { get; set; }

    protected override void OnInitialized()
    {
        // Use localized values if default values are still set
        if (Subject == "Email Subject")
        {
            Subject = L["Email Subject"];
        }
        if (CallToActionText == "Click Here")
        {
            CallToActionText = L["Click Here"];
        }
    }
}
