@* Reusable text block component for email templates *@
@* Uses table-based layout for maximum compatibility *@

<table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: @MarginBottom;">
    <tr>
        <td align="@Align" style="padding: @Padding;">
            @if (!string.IsNullOrEmpty(Heading))
            {
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td style="font-family: @FontFamily; font-size: @HeadingSize; color: @HeadingColor; font-weight: bold; line-height: @HeadingLineHeight; margin: 0; padding-bottom: @HeadingMarginBottom;">
                            @Heading
                        </td>
                    </tr>
                </table>
            }

            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                    <td style="font-family: @FontFamily; font-size: @FontSize; color: @TextColor; line-height: @LineHeight; margin: 0;">
                        @if (ChildContent != null)
                        {
                            @ChildContent
                        }
                        else if (!string.IsNullOrEmpty(Text))
                        {
                            @((MarkupString)Text.Replace("\n", "<br/>"))
                        }
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

@code {
    /// <summary>
    /// Optional heading text displayed above the main content
    /// </summary>
    [Parameter]
    public string? Heading { get; set; }

    /// <summary>
    /// Heading font size (default: 22px)
    /// </summary>
    [Parameter]
    public string HeadingSize { get; set; } = "22px";

    /// <summary>
    /// Heading color (default: #333333)
    /// </summary>
    [Parameter]
    public string HeadingColor { get; set; } = "#333333";

    /// <summary>
    /// Heading line height (default: 1.3)
    /// </summary>
    [Parameter]
    public string HeadingLineHeight { get; set; } = "1.3";

    /// <summary>
    /// Space below heading (default: 15px)
    /// </summary>
    [Parameter]
    public string HeadingMarginBottom { get; set; } = "15px";

    /// <summary>
    /// Simple text content (can use \n for line breaks)
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Advanced content using RenderFragment for complex layouts
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Text alignment: left, center, right (default: left)
    /// </summary>
    [Parameter]
    public string Align { get; set; } = "left";

    /// <summary>
    /// Font family (default: Arial, sans-serif)
    /// </summary>
    [Parameter]
    public string FontFamily { get; set; } = "Arial, sans-serif";

    /// <summary>
    /// Font size (default: 16px)
    /// </summary>
    [Parameter]
    public string FontSize { get; set; } = "16px";

    /// <summary>
    /// Text color (default: #666666)
    /// </summary>
    [Parameter]
    public string TextColor { get; set; } = "#666666";

    /// <summary>
    /// Line height for better readability (default: 1.6)
    /// </summary>
    [Parameter]
    public string LineHeight { get; set; } = "1.6";

    /// <summary>
    /// Padding around the text block (default: 10px 0)
    /// </summary>
    [Parameter]
    public string Padding { get; set; } = "10px 0";

    /// <summary>
    /// Bottom margin for spacing between blocks (default: 20px)
    /// </summary>
    [Parameter]
    public string MarginBottom { get; set; } = "20px";
}
