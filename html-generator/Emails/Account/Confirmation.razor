
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates

<SimpleActionEmailTemplate
    Subject="Lien de confirmation de création de compte"
    Greeting=@($"{User.FirstName} {User.LastName}")
    CallToActionUrl="@ConfirmationLink"
    CallToActionText="Cliquez ici pour confirmer mon inscription"
    FooterText="Vous recevez cet email car vous tentez de créer un compte sur notre plateform."
>
    <p>Pour confirmer la création de votre compte sur notre plateforme, veuillez cliquez sur le bouton ci-dessous.</p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ConfirmationLink {get;set;}
}
