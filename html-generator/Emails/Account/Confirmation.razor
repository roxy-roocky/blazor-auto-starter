
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates

<SimpleActionEmailTemplate
    Subject="Account Creation Confirmation Link"
    Greeting=@_greetings
    CallToActionUrl="@ConfirmationLink"
    CallToActionText="Click here to confirm my registration"
    FooterText="You are receiving this email because you are trying to create an account on our platform."
>
    <p>To confirm the creation of your account on our platform, please click the button below.</p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ConfirmationLink {get;set;}

    protected virtual string _greetings {
        get{
            var gr = $"{User.FirstName} {User.LastName}";

            return string.IsNullOrWhiteSpace(gr) ? User.Email!.Split('@').First() : gr;
        }
    }
}
