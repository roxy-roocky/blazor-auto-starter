
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Confirmation> L

<SimpleActionEmailTemplate
    Subject="@L["Account Creation Confirmation Link"]"
    Greeting=@_greetings
    CallToActionUrl="@ConfirmationLink"
    CallToActionText="@L["Click here to confirm my registration"]"
    FooterText="@L["You are receiving this email because you are trying to create an account on our platform."]"
>
    <p>@L["To confirm the creation of your account on our platform, please click the button below."]</p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ConfirmationLink {get;set;}

    protected virtual string _greetings {
        get{
            var gr = $"{User.FirstName} {User.LastName}";

            return string.IsNullOrWhiteSpace(gr) ? User.Email!.Split('@').First() : gr;
        }
    }
}
