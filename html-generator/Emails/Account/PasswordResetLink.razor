
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates

<SimpleActionEmailTemplate
    Subject="Lien de réinitialisation de mot de passe"
    Greeting=@($"{User.FirstName} {User.LastName}")
    CallToActionUrl="@ResetLink"
    CallToActionText="Cliquez ici pour réinitialiser mon mot de passe"
    FooterText="Vous recevez cet email car une demande de réinitialisation de mot de passe a été effectuée pour votre compte.\nSi vous n'êtes pas à l'origine de cette demande, veuillez ignorer cet email."
>
    <p>Pour réinitialiser votre mot de passe, veuillez cliquer sur le bouton ci-dessous.</p>

    <p style="text-align: center; color: #666; font-size: 14px; margin-top: 20px;">
        Ce lien est valide pendant 15 minutes.
    </p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ResetLink {get;set;}
}
