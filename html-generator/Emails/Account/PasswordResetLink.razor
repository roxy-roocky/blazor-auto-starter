
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<PasswordResetLink> L

<SimpleActionEmailTemplate
    Subject="@L["Password Reset Link"]"
    Greeting=@_greetings
    CallToActionUrl="@ResetLink"
    CallToActionText="@L["Click here to reset my password"]"
    FooterText="@L["You are receiving this email because a password reset request was made for your account.\nIf you did not make this request, please ignore this email."]"
>
    <p>@L["To reset your password, please click the button below."]</p>

    <p style="text-align: center; color: #666; font-size: 14px; margin-top: 20px;">
        @L["This link is valid for 15 minutes."]
    </p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ResetLink {get;set;}

    protected virtual string _greetings {
        get{
            var gr = $"{User.FirstName} {User.LastName}";

            return string.IsNullOrWhiteSpace(gr) ? User.Email!.Split('@').First() : gr;
        }
    }
}
