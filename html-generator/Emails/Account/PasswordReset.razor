
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates

<SimpleActionEmailTemplate
    Subject="Code de réinitialisation de mot de passe"
    Greeting=@($"{User.FirstName} {User.LastName}")
    FooterText="Vous recevez cet email car une demande de réinitialisation de mot de passe a été effectuée pour votre compte.\nSi vous n'êtes pas à l'origine de cette demande, veuillez ignorer cet email."
>
    <p>Pour réinitialiser votre mot de passe, veuillez utiliser le code suivant :</p>

    <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td style="padding: 20px 0; text-align: center;">
                <div style="background-color: #f5f5f5; border: 2px solid #975b45; border-radius: 8px; display: inline-block; padding: 20px 40px; font-family: 'Courier New', monospace; font-size: 32px; font-weight: bold; color: #333; letter-spacing: 8px;">
                    @ResetCode
                </div>
            </td>
        </tr>
    </table>

    <p style="text-align: center; color: #666; font-size: 14px; margin-top: 20px;">
        Ce code est valide pendant 15 minutes.
    </p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ResetCode {get;set;}
}
