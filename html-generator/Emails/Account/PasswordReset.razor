
@using html_generator.Emails.Shared
@using html_generator.Emails.Templates
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<PasswordReset> L

<SimpleActionEmailTemplate
    Subject="@L["Password Reset Code"]"
    Greeting=@_greetings
    FooterText="@L["You are receiving this email because a password reset request was made for your account.\nIf you did not make this request, please ignore this email."]"
>
    <p>@L["To reset your password, please use the following code:"]</p>

    <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td style="padding: 20px 0; text-align: center;">
                <div style="background-color: #f5f5f5; border: 2px solid #975b45; border-radius: 8px; display: inline-block; padding: 20px 40px; font-family: 'Courier New', monospace; font-size: 32px; font-weight: bold; color: #333; letter-spacing: 8px;">
                    @ResetCode
                </div>
            </td>
        </tr>
    </table>

    <p style="text-align: center; color: #666; font-size: 14px; margin-top: 20px;">
        @L["This code is valid for 15 minutes."]
    </p>
</SimpleActionEmailTemplate>

@code {
    [Parameter, EditorRequired]
    public main_datacontext.Identity.User User {get;set;}

    [Parameter, EditorRequired]
    public string ResetCode {get;set;}

    protected virtual string _greetings {
        get{
            var gr = $"{User.FirstName} {User.LastName}";

            return string.IsNullOrWhiteSpace(gr) ? User.Email!.Split('@').First() : gr;
        }
    }
}
